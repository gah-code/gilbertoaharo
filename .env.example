# Placeholder environment template for local development.
# Real values must be configured outside git.

# public-client (compiled into browser bundle)
VITE_CONTENT_SOURCE=contentful
VITE_BUILD_TARGET=prod
VITE_SITE_URL=https://example.com
VITE_SITE_NAME=Your Site Name
VITE_ARTICLE_ROUTE_PREFIX=/articles
VITE_CONTENTFUL_SPACE_ID=your_contentful_space_id
VITE_CONTENTFUL_ENVIRONMENT=master
VITE_CONTENTFUL_INCLUDE_CONTENT_SOURCE_MAPS=false

# temporary-client-exposed (transitional)
# Current architecture still fetches Contentful from the browser.
# Phase 4 may migrate this to a server-only boundary.
VITE_CONTENTFUL_DELIVERY_TOKEN=your_contentful_delivery_token
