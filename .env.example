# Copy this file to .env.local for local development.
# Never commit real environment values.

VITE_CONTENT_SOURCE=contentful
VITE_CONTENTFUL_SPACE_ID=YOUR_CONTENTFUL_SPACE_ID
VITE_CONTENTFUL_DELIVERY_TOKEN=YOUR_CONTENTFUL_DELIVERY_TOKEN
VITE_CONTENTFUL_ENVIRONMENT=master

VITE_SITE_URL=https://example.com

# Optional overrides
# VITE_ARTICLE_ROUTE_PREFIX=/your-articles-prefix
# VITE_BUILD_TARGET=prod
VITE_CONTENTFUL_INCLUDE_CONTENT_SOURCE_MAPS=false
